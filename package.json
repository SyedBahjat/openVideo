{
  "name": "openvideo",
  "productName": "openVideo",
  "version": "0.2.0",
  "description": "Open-source screen + camera recorder for macOS and Windows. Record locally, read from a voice-following teleprompter only you can see, draw on screen, share links that store videos in your own GitHub.",
  "author": "Syed Bahjat",
  "license": "MIT",
  "homepage": "https://github.com/SyedBahjat/openVideo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SyedBahjat/openVideo.git"
  },
  "bugs": {
    "url": "https://github.com/SyedBahjat/openVideo/issues"
  },
  "keywords": [
    "screen-recorder",
    "loom-alternative",
    "electron",
    "video",
    "screen-recording",
    "webcam",
    "async-video",
    "nextjs",
    "open-source",
    "teleprompter"
  ],
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test lib.test.js prompter.test.js",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "build:speech": "sh native/build-mac.sh",
    "predist:mac": "npm run build:speech"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "org.openvideo.app",
    "files": [
      "main.js",
      "preload.js",
      "lib.js",
      "share.js",
      "config.js",
      "renderer/**",
      "teleprompter.js"
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "openVideo uses the camera only while you record.",
        "NSMicrophoneUsageDescription": "openVideo uses the microphone only while you record.",
        "NSAudioCaptureUsageDescription": "openVideo can record system audio while you record.",
        "NSSpeechRecognitionUsageDescription": "openVideo uses on-device speech recognition so the teleprompter can follow along as you read."
      },
      "identity": "-",
      "extraResources": [
        {
          "from": "native/bin/openvideo-speech",
          "to": "speech/openvideo-speech"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "native/speech-win.ps1",
          "to": "speech/speech-win.ps1"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "dmg": {
      "title": "openVideo ${version}",
      "background": "build/background.png",
      "iconSize": 112,
      "window": {
        "width": 660,
        "height": 420
      },
      "contents": [
        {
          "x": 180,
          "y": 215,
          "type": "file"
        },
        {
          "x": 480,
          "y": 215,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "afterSign": "build/after-sign.js"
  }
}
