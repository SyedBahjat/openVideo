# GitHub OAuth App (https://github.com/settings/developers)
#   Callback URL: <your site>/api/auth/callback
#   Tick "Enable Device Flow" too: the desktop app signs in with the same client id.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Random string, 32+ chars:  openssl rand -base64 32
SESSION_SECRET=

# Optional
# GitHub token with no scopes: raises GitHub share-page API limit from 60 to 5000 requests/hour
GITHUB_TOKEN=
# Shows a "Get the desktop app" button on the landing page
DESKTOP_DOWNLOAD_URL=
